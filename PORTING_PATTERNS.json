{
  "description": "Engine-agnostic GPU compute porting patterns. Maps source API constructs to target API equivalents with transformation notes, complexity ratings, and known caveats.",
  "last_updated": "2026-10-23T00:00:00Z",

  "patterns": {

    "cuda_to_hip": {
      "name": "CUDA → HIP",
      "source": "CUDA",
      "target": "HIP (AMD ROCm)",
      "complexity": "low",
      "auto_translatable": ["hipify-perl", "hipify-python"],
      "manual_transforms": {
        "cudaMalloc": {"hip": "hipMalloc", "notes": "Direct replacement, same semantics"},
        "cudaFree": {"hip": "hipFree", "notes": "Direct replacement"},
        "cudaMemcpy": {"hip": "hipMemcpy", "notes": "Add hipMemcpyKind::hipMemcpyDefault if direction unclear"},
        "cudaMemcpyHostToDevice": {"hip": "hipMemcpyHostToDevice", "notes": "Same enum value"},
        "cudaMemcpyDeviceToHost": {"hip": "hipMemcpyDeviceToHost", "notes": "Same enum value"},
        "cudaMemcpyDeviceToDevice": {"hip": "hipMemcpyDeviceToDevice", "notes": "Same enum value"},
        "cudaStreamCreate": {"hip": "hipStreamCreate", "notes": "Direct replacement"},
        "cudaStreamSynchronize": {"hip": "hipStreamSynchronize", "notes": "Direct replacement"},
        "cudaEventRecord": {"hip": "hipEventRecord", "notes": "Direct replacement"},
        "cudaEventSynchronize": {"hip": "hipEventSynchronize", "notes": "Direct replacement"},
        "cudaDeviceSynchronize": {"hip": "hipDeviceSynchronize", "notes": "Direct replacement"},
        "<<<>>>": {"hip": "hipLaunchKernelGGL()", "notes": "Kernel launch syntax change — hipify handles automatically"},
        "__syncthreads": {"hip": "__syncthreads", "notes": "Direct replacement in HIP"},
        "blockIdx": {"hip": "hipThreadIdx_x", "notes": "hipify auto-replaces blockIdx → hipBlockIdx"},
        "threadIdx": {"hip": "hipThreadIdx", "notes": "hipify auto-replaces"},
        "threadIdx.x": {"hip": "hipThreadIdx_x", "notes": "hipify auto-replaces"},
        "blockIdx.x": {"hip": "hipBlockIdx_x", "notes": "hipify auto-replaces"},
        "blockDim": {"hip": "hipBlockDim", "notes": "hipify auto-replaces"},
        "gridDim": {"hip": "hipGridDim", "notes": "hipify auto-replaces"},
        "__umulhi": {"hip": "__umulhi", "notes": "Supported on AMD in ROCm 6+"},
        "__ldg": {"hip": "__ldg", "notes": "Supported"},
        "__float2half": {"hip": "__float2half", "notes": "Supported"},
        "__half2float": {"hip": "__half2float", "notes": "Supported"}
      },
      "manual_only": {
        "wmma": {"hip": "rocWMMA (gfx1100+, gfx1200/gfx1201) or F32 fallback", "notes": "RDNA4 (gfx1200/gfx1201) supports rocWMMA. Use __builtin_amdgcn_wmma_*_gfx12 intrinsics. RDNA2 (gfx1030) has NO WMMA — use F32 fallback"},
        "mma": {"hip": "rocBLASLt or dot4 instructions", "notes": "Tensor cores → dot4 or rocBLASLt"},
        "tensor_core_mma": {"hip": "rocWMMA or rocBLASLt MMA API", "notes": "Requires ROCm 5.7+"},
        "nvrtc": {"hip": "hiprtc or runtime compilation via HIPRTC", "notes": "Different API but similar concept"},
        "cuMemPool": {"hip": "hipMemPool (if available) or hipMalloc managed", "notes": "Memory pooling support varies by ROCm version"},
        "cudaGraph": {"hip": "hipGraph (experimental)", "notes": "HIP graphs are experimental; may need fallback"},
        "cuStreamWorkDescrib": {"hip": "hipStreamWorkStealing", "notes": "Different semantics"},
        "header_order": {"hip": "Include runtime FIRST", "notes": "MUST #include hip_runtime.h BEFORE custom headers using __device__/__forceinline__/__shared__"}
      },
      "hipify_notes": {
        "command": "hipify-perl source.cu > target.cpp --inplace",
        "flags": ["--inplace", "--inplace-relative-prefix", "--no-backup"],
        "caveats": [
          "hipify does NOT handle WMMA → rocWMMA conversion automatically",
          "hipify does NOT handle tensor core intrinsics (mma/sm) automatically",
          "hipify does NOT handle CUDA Graphs automatically",
          "hipify replaces __syncthreads with __syncthreads in HIP 6+"
        ]
      }
    },

    "cuda_to_sycl": {
      "name": "CUDA → oneAPI DPC++/SYCL",
      "source": "CUDA",
      "target": "SYCL (Intel oneAPI)",
      "complexity": "high",
      "auto_translatable": ["dpct (Intel DPC++ Compatibility Tool)"],
      "manual_transforms": {
        "cudaMalloc": {"sycl": "sycl::malloc_device", "notes": "SYCL uses unified memory model"},
        "cudaFree": {"sycl": "sycl::free", "notes": "Must specify queue"},
        "cudaMemcpy": {"sycl": "queue.copy or handler.copy", "notes": "Explicit copy vs unified memory"},
        "cudaStreamCreate": {"sycl": "sycl::queue", "notes": "Queue replaces stream concept"},
        "<<<blocks, threads>>>": {"sycl": "parallel_for(nd_range(...))", "notes": "Different kernel launch model"},
        "threadIdx.x": {"sycl": "item.get_local_id(0)", "notes": "Index space access differs"},
        "blockIdx.x": {"sycl": "item.get_group(0)", "notes": "Group indexing"},
        "blockDim.x": {"sycl": "item.get_local_range(0)", "notes": "Local range"},
        "gridDim.x": {"sycl": "item.get_group_range(0)", "notes": "Group range"},
        "__syncthreads": {"sycl": "item.barrier()", "notes": "Requires nd_item parameter"},
        "warpSize": {"sycl": "get_sub_group().get_local_range()", "notes": "Subgroup size varies by target"},
        "threadIdx.x % 32": {"sycl": "item.get_local_id(0) % sub_group_size", "notes": "Subgroup size is target-specific"},
        "shared_memory": {"sycl": "sycl::local_accessor<T, 1>", "notes": "Different declaration syntax"},
        "wmma": {"sycl": "dp4a or joint_matrix (SYCL 2020)", "notes": "oneAPI has joint_matrix extension for matrix ops"},
        "mma": {"sycl": "oneMKL gemm or joint_matrix", "notes": "Use oneMKL for BLAS, joint_matrix for tensors"}
      },
      "dpct_notes": {
        "command": "dpct -outdir <output> <source>",
        "support_level": "70% auto, 30% manual",
        "caveats": [
          "DPCT cannot auto-migrate WMMA/tensor core code",
          "CUDA graphs require manual rewrite",
          "Memory model differences (explicit vs unified) may need design changes",
          "Subgroup/warp programming needs manual adjustment"
        ]
      }
    },

    "cuda_to_vulkan": {
      "name": "CUDA → Vulkan Compute (SPIR-V)",
      "source": "CUDA",
      "target": "Vulkan Compute / SPIR-V",
      "complexity": "very_high",
      "auto_translatable": [],
      "manual_transforms": {
        "cudaMalloc": {"vulkan": "vkAllocateMemory + vkBindBufferMemory", "notes": "Full buffer creation pipeline"},
        "cudaMemcpy": {"vulkan": "vkCmdCopyBufferToImage / staging buffer", "notes": "Must use staging buffers for upload"},
        "cudaStreamCreate": {"vulkan": "vkCreateCommandPool + vkAllocateCommandBuffers", "notes": "Command buffer model"},
        "<<<>>>": {"vulkan": "vkCmdDispatch", "notes": "Workgroup size defined in shader via layout(local_size_x=N)"},
        "threadIdx": {"vulkan": "gl_GlobalInvocationID / gl_LocalInvocationID", "notes": "Built-in variables in GLSL/SPIR-V"},
        "blockIdx": {"vulkan": "gl_WorkGroupID", "notes": "Built-in variable"},
        "blockDim": {"vulkan": "gl_WorkGroupSize", "notes": "Built-in variable"},
        "gridDim": {"vulkan": "gl_NumWorkGroups", "notes": "Built-in variable"},
        "__syncthreads": {"vulkan": "shared/shared variables + control flow", "notes": "No explicit barrier; use executionBarrier() / OpControlBarrier"},
        "shared_memory": {"vulkan": "shared variables in GLSL / OpVariable with Shared storage class", "notes": "Different declaration"},
        "wmma": {"vulkan": "GL_KHR_cooperative_matrix (NVIDIA) or GL_KHR_shader_integer_dot_product (DP4a AMD)", "notes": "AMD CM broken → use DP4a"},
        "mma": {"vulkan": "GL_KHR_shader_integer_dot_product (dp4) or CM", "notes": "NVIDIA: CM works. AMD: broken, use DP4a"},
        "texture_2d": {"vulkan": "subpassLoad / texture() with sampler", "notes": "Image load/store vs texture sampling"},
        "surface": {"vulkan": "imageStore / atomicImageOp", "notes": "Different write semantics"},
        "warp shuffle": {"vulkan": "subgroup operations (GL_KHR_vulkan_glsl) or SM extension", "notes": "Subgroup ops in SPIR-V"},
        "__ldg": {"vulkan": "OpLoad with Aligned hint (or just read-only buffer)", "notes": "Read-only access pattern"}
      },
      "vulkan_notes": {
        "compilation": "glslc shader.comp -o shader.spv OR dxc -T cs_6_6 shader.hlsl -E main -spirv",
        "validation": "spirv-val shader.spv",
        "optimisation": "spirv-opt -O shader.spv -o shader_opt.spv",
        "runtime": "vkCreateShaderModule + vkCreateComputePipelines + vkCmdBindPipeline + vkCmdDispatch",
        "amd_caveat": "CooperativeMatrix extension is broken on AMD Vulkan drivers. Use DP4a (GL_KHR_shader_integer_dot_product) for all matmul operations on AMD.",
        "nvidia_ok": "CooperativeMatrix works on NVIDIA Vulkan drivers SM 7.5+ (535.x+) via GL_NV_cooperative_matrix"
      }
    },

