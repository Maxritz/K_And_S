  "memory_models": {
    "cuda": {
      "model": "Explicit allocation + transfer",
      "managed_memory": "cudaMallocManaged (optional, slower on AMD)",
      "unified": false,
      "pinning": "cudaHostAlloc / cudaHostRegister",
      "prefetch": "cudaMemPrefetchAsync (CUDA 11+)"
    },
    "hip": {
      "model": "Explicit allocation + transfer",
      "managed_memory": "hipMallocManaged (varies by ROCm version)",
      "unified": false,
      "pinning": "hipHostMalloc / hipHostRegister",
      "prefetch": "hipMemPrefetchAsync (ROCm 5+)"
    },
    "sycl": {
      "model": "Unified shared memory (USM) + explicit buffers",
      "managed_memory": "sycl::malloc_shared (implicitly managed)",
      "unified": true,
      "pinning": "N/A (unified)",
      "prefetch": "queue.prefetch (implicit in USM)"
    },
    "vulkan": {
      "model": "Explicit buffer/image resources",
      "managed_memory": "N/A (fully explicit)",
      "unified": false,
      "pinning": "staging buffers",
      "prefetch": "vkCmdCopyBuffer → pipeline barrier"
    },
    "directx12": {
      "model": "Explicit heap allocation + upload/download",
      "managed_memory": "N/A (fully explicit)",
      "unified": false,
      "pinning": "Upload heap",
      "prefetch": "Resource barriers"
    }
  },

  "sync_patterns": {
    "description": "Fence / synchronization patterns to avoid TDRs (Timeout Detection and Recovery) and GPU hangs",
    "tdr_limits_ms": {
      "windows_cuda": 2000,
      "windows_directx": 2000,
      "windows_vulkan": 2000,
      "linux_cuda": 60000,
      "linux_vulkan": 60000
    },
    "fence_types": {
      "cuda": {
        "host_sync": "cudaEventSynchronize / cudaStreamSynchronize",
        "device_sync": "__syncthreads() (intra-block only)",
        "async_signal": "cudaEventRecord + cudaStreamWaitEvent",
        "timeout": "cudaEventSynchronize (no built-in timeout, must poll or use stream)"
      },
      "hip": {
        "host_sync": "hipEventSynchronize / hipStreamSynchronize",
        "device_sync": "__syncthreads() (intra-block only)",
        "async_signal": "hipEventRecord + hipStreamWaitEvent",
        "timeout": "hipEventSynchronize (poll with hipEventQuery for timeout)"
      },
      "vulkan": {
        "host_sync": "vkWaitFences / vkWaitSemaphores",
        "device_sync": "OpMemoryBarrier / OpControlBarrier (SPIR-V)",
        "async_signal": "VkSemaphore (binary or timeline)",
        "timeout": "vkWaitFences(pFence, timeoutNs=INF) or vkAcquireNextImageKHR(timeout)"
      },
      "directx12": {
        "host_sync": "ID3D12Fence::SetEventOnCompletion + WaitForSingleObject",
        "device_sync": "All_Barrier (D3D12_BARRIER), GroupMemoryBarrierWithGroupSync",
        "async_signal": "ID3D12Fence (timeline)",
        "timeout": "WaitForSingleObject(timeoutMs). Must use timeline fences for long GPU work"
      },
      "sycl": {
        "host_sync": "queue.wait() (blocks until queue idle)",
        "device_sync": "nd_item::barrier()",
        "async_signal": "queue.ext_oneapi_submit_barrier()",
        "timeout": "queue.wait() (blocks). Use queue.is_submitted work tracking for soft timeout"
      }
    },
    "tdr_avoidance": {
      "principle": "Never let a GPU kernel run > 2s (Windows default) without yielding",
      "cuda": "Split long kernels into chunks. Use cudaStreamQuery to check completion. Insert events between chunks.",
      "hip": "Split kernels at 1024-thread boundary. Use hipEventQuery for polling.",
      "vulkan": "Use timeline semaphores (VK_FENCE_TYPE_TIMELINE) for multi-second operations. Insert VkSemaphore after each queue submission.",
      "directx12": "Use timeline fence (ID3D12Fence at fenceValue). Signal+wait for each batch. Call IDXGISwapChain::Present(1, 0) with GPU wait.",
      "sycl": "Submit work in small chunks. Use queue.wait_with_khr_event() to poll. Avoid blocking waits on single large kernels."
    },
    "translation_patterns": {
      "cuda_to_vulkan": {
        "cudaEventRecord": "vkCmdWriteTimestamp + VkSemaphore signaled",
        "cudaStreamSynchronize": "vkQueueWaitIdle OR vkWaitFences with timeout",
        "cudaDeviceSynchronize": "vkDeviceWaitIdle",
        "warning": "vkQueueWaitIdle blocks the CPU thread — use fences with timeout instead for TDR safety"
      },
      "cuda_to_directx12": {
        "cudaEventRecord": "ID3D12Device5::SignalFence(fence, value)",
        "cudaStreamSynchronize": "ID3D12Fence::SetEventOnCompletion(value, event) + WaitForSingleObject",
        "cudaDeviceSynchronize": "ID3D12Device::WaitForFence() with polling",
        "warning": "Always use timeline fences for multi-second GPU operations. Legacy fences can cause TDR on Windows."
      },
      "hip_to_vulkan": {
        "hipEventRecord": "vkCmdWriteTimestamp(slot, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT)",
        "hipStreamSynchronize": "vkQueueWaitIdle OR vkWaitFences with timeout",
        "hipDeviceSynchronize": "vkDeviceWaitIdle"
      }
    },
    "no_placeholder_fences": {
      "never_allow": [
        "// TODO: add sync",
        "/* no fence */",
        "// stub: assume done",
        "cudaDeviceSynchronize(); // placeholder"
      ],
      "required_pattern": "Every kernel submission MUST have a fence/semaphore pair. At minimum, insert `query_toolchain()` for the proper fence pattern on your target."
    }
  },

