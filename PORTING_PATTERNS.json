        "blockIdx": {"cuda": "blockIdx", "notes": "No change"},
        "__syncthreads": {"cuda": "__syncthreads", "notes": "No change"}
      },
      "manual_only": {
        "wmma": {"cuda": "Check arch WMMA support (sm_75+ for FP16 WMMA, sm_80+ for BF16/TF32)", "notes": "Tensor Core intrinsics are arch-specific"},
        "mma": {"cuda": "Check tensor core support for target SM", "notes": "mma.sm80 only on sm_80+"},
        "tensor_core_mma": {"cuda": "Verify tensor core availability on target arch", "notes": "May need to disable on older arches"},
