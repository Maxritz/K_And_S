{
  "description": "GPU architecture capability matrix.  Each entry is the MINIMUM set of features a GPU must have for an engine's kernels to compile (or to dispatch correctly).  Used to decide which arch-specific code paths to add.",
  "fields": {
    "name": "Human-readable GPU name",
    "vendor": "NVIDIA|AMD|Intel|Apple",
    "vendor_id": "gfx1030|sm_80|adln_g|apple_m2",
    "wave_size": "Wavefront/warp size in threads (32 for NVIDIA/curry, 32/64 for AMD RDNA/CDNA, 32 for Intel)",
    "lds_kib": "Local data share / shared memory per CU in KiB",
    "tensor_cores": "bool: does this arch have tensor cores/MMA units",
    "wmma": "bool: does this arch support Wave Matrix Multiply-Accumulate",
    "dot4": "bool: does this arch have native int8 dot-product instruction",
    "dot8": "bool: does this arch have native int8 dot-product-8 instruction",
    "bf16_native": "bool: native bf16 math (no emulation)",
    "fp8_native": "bool: native FP8 format support",
    "known_issues": [
      "array of strings"
    ]
  },
